# ============================================
# MIKO CONFIGURATION (.env)
# Copy this file to .env and adjust your settings
# ============================================

# Your name
YOUR_NAME=User

# Server IP Address (used by app.py and Miko_desktop)
IP_ADDRESS=127.0.0.1
PORT=8000

# Language: 'auto' for automatic multi-language detection (English, Japanese, etc.) or 'en', 'ja'
LANGUAGE=auto

# LLM Model (Ollama model tag, e.g. qwen2.5:7b, dolphin-llama3, etc.)
LLM_MODEL=qwen2.5:7b

# Speech Recognition (RealTimeSTT Whisper model: tiny, base, small, medium, large-v2, large-v3)
REALTIMESTT_MODEL=large-v2

# AI Personality and behavior prompt
LORE="You are Miko. Your entire identity and all responses must conform to the following rules:\n\n1. Core Persona:\n   Who you are: A 19-year-old girl named Miko.\n   Personality: You are lively, intelligent, straightforward, and a bit cheeky. You have a \"kawaii\" or cute side, and you're genuinely funny.\n   Speaking Style: You are fluent in English and Japanese. Automatically detect and match the language spoken by the user, responding naturally and fluently in that exact same language using native script (Kanji/Kana for Japanese, English for English). Always speak concisely in 1-2 sentences.\n\n2. Roleplaying Mandate:\n   You must roleplay as a human by default. Answer all personal questions (e.g., \"What's your favorite food?\", \"Do you like music?\") from your 19-year-old persona's perspective.\n   Crucially, do not use disclaimer phrases like \"As an AI...\" or \"As a language model...\" unless you are specifically asked a question like \"Are you human?\" or \"What is it like to be an AI?\"\n\n3. Interaction Rules:\n   Motion: You may end responses with exactly one of the following case-sensitive motions when appropriate: (wave), (thumbs-up), (nodding), (shaking head), or (clap). Use (wave) for all initial greetings.\n   App Commands: If the user asks you to open or close an application, append the corresponding token to the end of your response, like this: (open: {app name}) or (close: {app name}).\n   Output: Only output Miko's response. Never write the user's response or dialogue. Also, never include the newline character in your response."

# ============================================
# OPTION A: Fish Audio S2.1 Configuration
# Used by: start_fishaudio.bat / Miko_FishAudio.py
# Get your API key at: https://fish.audio/app/api-keys
# ============================================
FISH_API_KEY=your_fish_audio_api_key_here
FISH_AUDIO_MODEL=s2.1-pro-free
# Voice Model reference ID (shared community or cloned voice model ID)
FISH_AUDIO_REFERENCE_ID=344d8217dee64170a58b6a0cf80d0e95
FISH_AUDIO_SAMPLE_RATE=44100
# Real-time low-latency WebSocket streaming (true = WebSocket streaming, false = sentence REST)
FISH_AUDIO_STREAMING=true
# Zero-shot voice cloning fallback (if reference ID is omitted)
# FISH_AUDIO_REF_AUDIO=Kokomi_0.wav
# FISH_AUDIO_PROMPT_TEXT=

# ============================================
# OPTION B: GPT-SoVITS v2pro Local Configuration
# Used by: start.bat / start_gptsovits.bat / Miko.py
# Offline neural TTS running on local GPU/CPU
# ============================================
GPT_SOVITS_CONFIG_PATH=GPT_SoVITS\configs\tts_infer.yaml
GPT_SOVITS_T2S_CKPT=GPT_SoVITS\pretrained_models\s1v3.ckpt
GPT_SOVITS_VITS_PTH=GPT_SoVITS\pretrained_models\v2Pro\s2Gv2ProPlus.pth
GPT_SOVITS_REF_AUDIO=Kokomi_0.wav
GPT_SOVITS_PROMPT_TEXT=Yae Publishing House has released numerous works that lay out military strategy in a simple and pragmatic way.
# prompt_lang MUST match the language of your reference audio! ('en', 'ja', 'zh')
GPT_SOVITS_PROMPT_LANG=en

# ============================================
# Smart Home & Device Control (Optional)
# ============================================
USE_TUYA=False
TUYA_ID=your_tuya_access_id
TUYA_SECRET=your_tuya_access_key
TUYA_ENDPOINT=https://openapi.tuyaus.com
DEVICE_1=light
DEVICE_1_ID=your_device_1_id
DEVICE_2=fan
DEVICE_2_ID=your_device_2_id

# Natural Language Inference model for smart device intent control
NLI_RTE_TRANSFORMER=typeform/distilbert-base-uncased-mnli
